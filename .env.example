# AgentPaywall — Stellar Testnet
# Official constants only. Never commit a filled .env.
# Copy to .env and fill VERIFY fields locally.

# CAIP-2 network id (do not invent another)
STELLAR_NETWORK=stellar:testnet

# Public testnet endpoints
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Testnet USDC (Circle) — official issuer + Soroban Asset Contract
# https://developers.stellar.org/docs/build/agentic-payments/x402
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_SAC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# OpenZeppelin Channels x402 facilitator (testnet)
# Docs: https://developers.stellar.org/docs/build/agentic-payments/x402/built-on-stellar
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet

# VERIFY: required for live /verify + /settle.
# Generate at https://channels.openzeppelin.com/testnet/gen
# Leave empty to run the API in stub mode (402 + local cap, no on-chain settle).
# auto = live when OZ_API_KEY + classic STELLAR_RECIPIENT are set; stub otherwise.
X402_MODE=auto
OZ_API_KEY=

# Resource server payTo — classic G... account that receives USDC.
# Needs a USDC trustline. Do not put a C... SAC address here.
STELLAR_RECIPIENT=

# Agent/CLI payer — S... secret for createEd25519Signer (classic G... from).
# Used when SPEND_ACCOUNT_CONTRACT_ID is empty. NEVER commit.
STELLAR_SECRET_KEY=

# Constructor owner of spend-account (the merchant G... secret). Required for
# live Exact from the C... so __check_auth accepts Vec<AccSignature>.
# Do not invent a second owner. NEVER commit.
STELLAR_RECIPIENT_SECRET=

# Optional: C... id printed by scripts/deploy-testnet.sh after YOU deploy.
# Not an official constant — leave empty until deploy succeeds.
# This repo’s public demo instance is documented in README “Live testnet demo”.
# When set, live agent pays USDC FROM this contract (on-chain daily cap).
SPEND_ACCOUNT_CONTRACT_ID=

# Human daily spend cap (USDC, 7 decimals on-chain). Stub + constructor default.
DAILY_CAP_USDC=0.01

# x402 Exact price per GET /v1/fx ("$0.001" = 10000 base units at 7 decimals)
X402_PRICE=$0.001

# Local bind (uncommon ports to avoid 3000/5173/8080)
API_HOST=127.0.0.1
API_PORT=40211
WEB_PORT=41791
VITE_API_URL=http://127.0.0.1:40211
